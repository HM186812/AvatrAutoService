    "docx": "^9.12.0",
    "dotenv": "^17.2.3",
    "html2canvas-pro": "^2.5.2",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/html2pdf.js": "^0.10.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "playwright-core": "^1.64.1",
