# ==============================================================================
# AVATR AUTO SERVICE LAOS - E2E TEST ENVIRONMENT TEMPLATE (.env.test.example)
# ສຳລັບໃຊ້ຮ່ວມກັບ Playwright E2E Tests (ແຍກຖານຂໍ້ມູນບໍ່ໃຫ້ຂຽນທັບ Production DB)
# ==============================================================================
# 💡 ວິທີໃຊ້ງານ:
# 1. ສຳເນົາໄຟລ໌ນີ້ເປັນ .env.test:
#    cp .env.test.example .env.test
# 2. ໃສ່ URL ແລະ Anon Key ຂອງ Supabase Test Branch ຫຼື Local Supabase (127.0.0.1:54321)
# 3. ຮັນຄຳສັ່ງທົດສອບ:
#    npm run test:e2e
# ==============================================================================

# Supabase Test Project / Branch URL (ຫ້າມໃຊ້ Production URL ເດັດຂາດ)
VITE_SUPABASE_URL="https://your-test-branch.supabase.co"

# Supabase Test Anon Public Key
VITE_SUPABASE_ANON_KEY="your-test-anon-key"

# Cloudflare Turnstile (ສາມາດປ່ອຍວ່າງໄວ້ເພື່ອ bypass ໃນໂໝດທົດສອບ)
VITE_TURNSTILE_SITE_KEY=""

# Base URL ສຳລັບ Playwright Web Server
APP_URL="http://localhost:3000"
