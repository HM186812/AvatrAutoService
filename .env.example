# ==============================================================================
# AVATR AUTO SERVICE LAOS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# ⚠️ SECURITY NOTICE / ຄຳເຕືອນດ້ານຄວາມປອດໄພ:
# 1. ຫ້າມ Commit ໄຟລ໌ .env ຕົວຈິງຂຶ້ນ Git ເດັດຂາດ (.env ຖືກລະບຸໃນ .gitignore ແລ້ວ)
# 2. ໃຊ້ສະເພາະ "anon" (Public Key) ສຳລັບ Frontend ເທົ່ານັ້ນ!
# 3. ຫ້າມໃສ່ "service_role" (Secret Key) ລົງໃນ Frontend ເດັດຂາດ ເພາະຈະເຮັດໃຫ້ລະບົບຮົ່ວໄຫຼ!
# ==============================================================================

# SUPABASE CLOUD CONFIGURATION (PostgreSQL + Auth + Storage + Realtime)
# ຊອກຫາໄດ້ທີ່: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# ⚠️ ໃສ່ສະເພາະ anon (public) key ເທົ່ານັ້ນ! (DO NOT use service_role key here)
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# GEMINI AI API (Required for smart assistant features if enabled)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP HOST URL
APP_URL="http://localhost:3000"

# CLOUDFLARE TURNSTILE BOT PROTECTION (Optional - Leave blank to bypass in local dev)
# Get your Site Key from Cloudflare Dashboard -> Turnstile
# Testing dummy keys provided by Cloudflare:
# - Always passes: 1x00000000000000000000AA
# - Always blocks: 2x00000000000000000000AB
VITE_TURNSTILE_SITE_KEY=""
